# =========================
# OS / Editor
# =========================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.tmp
*.bak

# =========================
# Environment files
# =========================
.env
.env.*
!.env.example

# Keep root env example if you want
# .env.example

# =========================
# Logs
# =========================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Root repo generated files
# =========================
coverage/
dist/
build/
tmp/
temp/

# =========================
# Frontend (Next.js / Node)
# =========================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/.vercel/
frontend/coverage/
frontend/dist/
frontend/build/
frontend/.eslintcache
frontend/.cache/
frontend/vitest-report.html
frontend/playwright-report/
frontend/test-results/

# Frontend env files
frontend/.env
frontend/.env.*
!frontend/.env.example

# Frontend lockfiles only ignore if you do NOT want them committed
# keep only the one your team uses
# frontend/package-lock.json
# frontend/pnpm-lock.yaml
# frontend/yarn.lock

# =========================
# Backend (Python / FastAPI)
# =========================
backend/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/**/*.pyd
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.coverage
backend/coverage.xml
backend/htmlcov/
backend/.tox/
backend/.nox/
backend/.venv/
backend/venv/
backend/env/
backend/.env
backend/.env.*
!backend/.env.example

# If your backend creates local DB files or temp artifacts
backend/*.sqlite3
backend/*.db
backend/*.db-journal

# Alembic / migration temp
backend/alembic/*__pycache__/

# =========================
# Docker / local runtime
# =========================
**/docker-data/
**/postgres-data/
**/redis-data/

# =========================
# Node/Python package manager caches
# =========================
frontend/node_modules/
backend/node_modules/
.pnpm-store/
.npm/
.yarn/